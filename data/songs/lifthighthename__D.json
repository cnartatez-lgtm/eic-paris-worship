  "sections": [
    {
      "label": "Verse 1",
      "lines": [
        {
          "parts": [
            {
              "chord": "D",
              "text": "Lift high the name of Jesus, of Jesus our King"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D",
              "text": "Make known the power of His grace"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D",
              "text": "The beauty of His peace"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A7",
              "text": "Re-member how His mercy reached"
            },
            {
              "chord": "D",
              "text": ""
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "G",
              "text": "And we cried out to Him"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D",
              "text": "He lifted us to solid ground"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A7",
              "text": "To freedom from our sin"
            },
            {
              "chord": "D",
              "text": ""
            }
          ]
        }
      ]
    },
    {
      "label": "Chorus",
      "lines": [
        {
          "parts": [
            {
              "chord": "D",
              "text": "Oh sing my soul, and tell all He's done"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D",
              "text": "Till the earth and heavens"
            },
            {
              "chord": "G",
              "text": ""
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Em",
              "text": "Are filled with His glo-ry"
            },
            {
              "chord": "A",
              "text": ""
            },
            {
              "chord": "D",
              "text": ""
            }
          ]
        }
      ]
    },
    {
      "label": "Verse 2",
      "lines": [
        {
          "parts": [
            {
              "chord": "D",
              "text": "Lift high the name of Jesus, of Jesus our Lord"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D",
              "text": "His power in us is greater than"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D",
              "text": "Is greater than this world"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A7",
              "text": "To share the reason for our hope"
            },
            {
              "chord": "D",
              "text": ""
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "G",
              "text": "To serve with love and grace"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D",
              "text": "That all who see Him shine through us"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A7",
              "text": "Might bring the Father praise"
            },
            {
              "chord": "D",
              "text": ""
            }
          ]
        }
      ]
