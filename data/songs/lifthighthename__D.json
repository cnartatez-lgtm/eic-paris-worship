              "text": "Can raise a soul to life"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A7",
              "text": "He opens up our eyes to see"
            },
            {
              "chord": "D",
              "text": ""
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "G",
              "text": "The harvest He has grown"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D",
              "text": "We labor in His fields of grace"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A7",
              "text": "As He leads sinners home"
            },
            {
