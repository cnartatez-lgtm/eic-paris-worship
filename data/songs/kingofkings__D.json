    },
    {
      "label": "[Verse 3]",
      "lines": [
        {
          "parts": [
            {
              "chord": "Bm7",
              "text": "And the morning that You rose"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A",
              "text": "All of heaven held its breath"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Bm7",
              "text": "Till that stone was moved for good"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A",
              "text": "For the Lamb had conquered death"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Bm7",
              "text": "And the dead rose from their tombs"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A",
              "text": "And the angels stood in awe"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Bm7",
              "text": "For the souls of all who'd come"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A",
              "text": "To the Father are restored"
            }
          ]
        }
      ]
    },
    {
      "label": "[Verse 4]",
      "lines": [
        {
          "parts": [
            {
              "chord": "D/F#",
              "text": "And the church of Christ was born"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A",
              "text": "Then the Spirit lit the flame"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D/F#",
              "text": "Now this gospel truth of old"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A",
              "text": "Shall not kneel, shall not faint"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D/F#",
              "text": "By His blood and in His name"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A",
              "text": "In His freedom I am free"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D/F#",
              "text": "For the love of Jesus Christ"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A",
              "text": "Who has resurrected me"
            }
          ]
        }
      ]
