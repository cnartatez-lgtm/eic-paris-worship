      "lines": [
        {
          "parts": [
            {
              "chord": "D",
              "text": "God of glory"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "G",
              "text": "Majesty"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Bm7",
              "text": "Praise forever to the King of"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D",
              "text": "Kings"
            }
          ]
        }
      ]
    },
    {
      "label": "[Verse 1]",
      "lines": [
        {
          "parts": [
            {
              "chord": "D/F#",
              "text": "In the darkness, we were waiting"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A",
              "text": "Without hope, without light"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D/F#",
              "text": "Till from heaven, You came running"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A",
              "text": "There was mercy in Your eyes"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D/F#",
              "text": "To fulfill the law and prophets"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A",
              "text": "To a virgin came the word"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D/F#",
              "text": "From a throne of endless glory"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A",
              "text": "To a cradle in the dirt"
            }
          ]
        }
      ]
    },
    {
      "label": "[Chorus]",
      "lines": [
        {
          "parts": [
            {
              "chord": "D",
              "text": "Praise the Father"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "G",
              "text": "Praise the Son"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Bm7",
              "text": "Praise the Spirit"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Asus4",
              "text": "Three in one"
            }
          ]
        }
      ]
    },
    {
      "label": "[Verse 2]",
      "lines": [
        {
          "parts": [
            {
              "chord": "D/F#",
              "text": "To reveal the kingdom coming"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A",
              "text": "And to reconcile the lost"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D/F#",
              "text": "To redeem the whole creation"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A",
              "text": "You did not despise the cross"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D/F#",
              "text": "For even in your suffering"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A",
              "text": "You saw to the other side"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D/F#",
              "text": "Knowing this was our salvation"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "A",
              "text": "Jesus for our sake you died"
            }
          ]
        }
      ]
    },
