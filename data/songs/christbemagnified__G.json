    {
      "label": "Bridge",
      "lines": [
        {
          "parts": [
            {
              "chord": "Cadd9",
              "text": "I "
            },
            {
              "chord": "Dadd11",
              "text": "won't bow to "
            },
            {
              "chord": "Em7",
              "text": "idols"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "G/B",
              "text": "I'll stand strong "
            },
            {
              "chord": "Cadd9",
              "text": "and worship You"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Dadd11",
              "text": "If it puts "
            },
            {
              "chord": "Em7",
              "text": "me in the fire"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "G/B",
              "text": "I'll rejoice 'cause You're there too"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Cadd9",
              "text": "I won't "
            },
            {
              "chord": "Dadd11",
              "text": "be formed by feelings"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Em7",
              "text": "I'll hold fast "
            },
            {
              "chord": "G/B",
              "text": "to what is true"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Cadd9",
              "text": "If the Cross "
            },
            {
              "chord": "Dadd11",
              "text": "brings transformation"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Em7",
              "text": "Then I'll be crucified with You"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "G/B",
              "text": "'Cause death "
            },
            {
              "chord": "Cadd9",
              "text": "is just the doorway"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Dadd11",
              "text": "Into resurrection life"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Em7",
              "text": "And If I join "
            },
            {
              "chord": "G/B",
              "text": "You in Your suffering"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Cadd9",
              "text": "Then I'll join "
            },
            {
              "chord": "Dadd11",
              "text": "You when You rise"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Em7",
              "text": "And when You "
            },
            {
              "chord": "G/B",
              "text": "return in glory"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Cadd9",
              "text": "With all the angels and the saints"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Dadd11",
              "text": "My heart "
            },
            {
              "chord": "Em7",
              "text": "will still be singing"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "G/B",
              "text": "My song "
            },
            {
              "chord": "Cadd9",
              "text": "will be the same"
            }
          ]
        }
