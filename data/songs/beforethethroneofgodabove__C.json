  "sections": [
    {
      "label": "Verse 1",
      "lines": [
        {
          "parts": [
            {
              "chord": "",
              "text": "Before the "
            },
            {
              "chord": "C",
              "text": "throne of "
            },
            {
              "chord": "F",
              "text": "God "
            },
            {
              "chord": "C",
              "text": "Above"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "I have a strong and perfect "
            },
            {
              "chord": "Em",
              "text": "plea"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "A great high "
            },
            {
              "chord": "F",
              "text": "priest whose "
            },
            {
              "chord": "G",
              "text": "name is "
            },
            {
              "chord": "Am",
              "text": "love"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "Who ever "
            },
            {
              "chord": "F",
              "text": "lives and "
            },
            {
              "chord": "G",
              "text": "pleads for "
            },
            {
              "chord": "C",
              "text": "me"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "My name is "
            },
            {
              "chord": "F",
              "text": "graven on his "
            },
            {
              "chord": "C",
              "text": "hands"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "My name is "
            },
            {
              "chord": "F",
              "text": "written "
            },
            {
              "chord": "G",
              "text": "on his "
            },
            {
              "chord": "Am",
              "text": "heart"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "I know that "
            },
            {
              "chord": "F",
              "text": "while in "
            },
            {
              "chord": "G",
              "text": "heaven he "
            },
            {
              "chord": "Am",
              "text": "stands"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "No tongue can "
            },
            {
              "chord": "F",
              "text": "bid me thence "
            },
            {
              "chord": "G",
              "text": "de--"
            },
            {
              "chord": "Am",
              "text": "part"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "No tongue can "
            },
            {
              "chord": "F",
              "text": "bid me thence "
            },
            {
              "chord": "G",
              "text": "de--"
            },
            {
              "chord": "C",
              "text": "part "
            }
          ]
        }
      ]
    },
    {
      "label": "Verse 2",
      "lines": [
        {
          "parts": [
            {
              "chord": "",
              "text": "When Satan tempts me to despair,"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "And tells me of the guilt within,"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "Upward I look, and see Him there"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "Who made an end to all my sin."
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "Because the sinless Savior died,"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "My sinful soul is counted free"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "For God the just is satisfied"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "To look on Him and pardon me (2x)"
            }
          ]
        }
      ]
    },
    {
      "label": "Chorus",
      "lines": [
        {
          "parts": [
            {
              "chord": "",
              "text": "Hallelujah! Hallelujah! Praise the One,"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "Risen Son of God!"
            }
          ]
        }
      ]
    },
    {
      "label": "Verse 3",
      "lines": [
        {
          "parts": [
            {
              "chord": "",
              "text": "Behold Him there, the Risen Lamb"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "My perfect, spotless righteousness,"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "The great unchangeable I am,"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "The King of glory and of grace!"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "One with Himself I cannot die"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "My soul is purchased by His blood"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "My life is hid with Christ on high,"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "",
              "text": "With Christ, my Savior and my God (2x)"
            }
          ]
        }
      ]
    }
  ],
