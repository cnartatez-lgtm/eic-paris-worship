    {
      "label": "Chorus 2",
      "lines": [
        {
          "parts": [
            {
              "chord": "D",
              "text": "So let it be today we shout the hymn of heaven"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D",
              "text": "With angels and the saints, we raise a mighty roar"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D",
              "text": "\"Glory to our God\" who gave us life beyond the grave"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "G",
              "text": "Holy, holy is the Lord"
            }
          ]
        }
      ]
