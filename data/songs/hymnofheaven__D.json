      ]
    },
    {
      "label": "Verse 3",
      "lines": [
        {
          "parts": [
            {
              "chord": "D",
              "text": "And on that day, we join the resurrection"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Bm",
              "text": "And stand beside the heroes of the faith"
            }
          ]
        }
      ]
