  "sections": [
    {
      "label": "Verse 1",
      "lines": [
        {
          "parts": [
            {
              "chord": "Am",
              "text": "From the highest of heights to the depths of the sea,"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Dm",
              "text": "Creation's revealing Your majesty."
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Am",
              "text": "From the colors of Fall to the fragrance of Spring,"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Dm",
              "text": "Every creature unique in the song that it sings."
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "F",
              "text": "All exclaiming:"
            }
          ]
        }
      ]
    },
    {
      "label": "Chorus",
      "lines": [
        {
          "parts": [
            {
              "chord": "C",
              "text": "Indescribable, uncontainable;"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "F",
              "text": "You placed the stars in the sky and You know them by name."
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "C",
              "text": "You are amazing, God!"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "C",
              "text": "All powerful, untamable."
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "F",
              "text": "Awestruck, we fall to our knees as we humbly proclaim,"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "C",
              "text": "You are amazing, God."
            }
          ]
        }
      ]
    },
    {
      "label": "Verse 2",
      "lines": [
        {
          "parts": [
            {
              "chord": "Am",
              "text": "Who has told every lightning bolt where it should go?"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Dm",
              "text": "Or seen heavenly storehouses laden with snow?"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Am",
              "text": "Who imagined the sun and gives source to its light,"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Dm",
              "text": "Yet conceals it to bring us the coolness of night?"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "F",
              "text": "None can fathom!"
            }
          ]
        }
      ]
    },
