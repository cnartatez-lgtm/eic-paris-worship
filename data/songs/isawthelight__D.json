              "chord": "D",
              "text": "Just like a blind man I wandered along"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "G",
              "text": "Worries and fears I claimed for my own"
            }
          ]
        },
        {
          "parts": [
