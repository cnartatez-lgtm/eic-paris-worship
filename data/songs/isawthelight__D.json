      "label": "Verse 1",
      "lines": [
        {
          "parts": [
            {
              "chord": "D",
              "text": "I wandered so aimless, life filled with sin"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "G",
              "text": "I wouldn't let my dear savior in"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D",
              "text": "Then Jesus came like a stranger in the night"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D",
              "text": "Praise the Lord, I saw the light"
            }
          ]
        }
      ]
    },
    {
      "label": "Chorus",
      "lines": [
        {
          "parts": [
            {
              "chord": "D",
              "text": "I saw the light, I saw the light"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "G",
              "text": "No more darkness, no more night"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D",
              "text": "Now I'm so happy, no sorrow in sight"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D",
              "text": "Praise the Lord, I saw the light"
