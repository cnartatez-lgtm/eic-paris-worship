    {
      "label": "Bridge",
      "lines": [
        {
          "parts": [
            {
              "chord": "Gadd9",
              "text": "I won't bow to"
            },
            {
              "chord": "Aadd11",
              "text": ""
            },
            {
              "chord": "Bm7",
              "text": ""
            },
            {
              "chord": "D/F#",
              "text": ""
            },
            {
              "chord": "Gadd9",
              "text": " idols"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Aadd11",
              "text": "I'll stand strong"
            },
            {
              "chord": "Gadd9",
              "text": " and worship You"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Bm7",
              "text": "If it puts me in the fire"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D/F#",
              "text": "I'll rejoice 'cause You're there too"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Gadd9",
              "text": "I won't be formed by feelings"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Aadd11",
              "text": "I'll hold fast to what is true"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Bm7",
              "text": "If the Cross brings transformation"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D/F#",
              "text": "Then I'll be crucified with You"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Gadd9",
              "text": "'Cause death is just the doorway"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Aadd11",
              "text": "Into resurrection life"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Bm7",
              "text": "And If I join You in Your suffering"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "D/F#",
              "text": "Then I'll join You when You rise"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Gadd9",
              "text": "And when You return in glory"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Aadd11",
              "text": "With all the angels and the saints"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Bm7",
              "text": "My heart will still be singing"
            }
          ]
        },
        {
          "parts": [
            {
              "chord": "Aadd11",
              "text": "My song will be the same"
            }
          ]
        }
